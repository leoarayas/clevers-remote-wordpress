{
    "name": "clevers/clevers-remote-wordpress",
    "description": "Clevers Remote Agent for managed WordPress sites.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "lint": "find . -path './vendor' -prune -o -path './.git' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        }
    }
}
